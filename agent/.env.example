# Copy this file to .env (same folder) and fill it in as the workshop tells
# you to. Chapter 0 needs the MODEL section; Chapters 3 and 4 each fill in
# their own.

# ── Your LLM (Chapter 0) ─────────────────────────────────────────────────────
# Bring your own model. MODEL takes any "provider:model" string LangChain's
# init_chat_model understands; each provider reads its own key variables.
#
#   Azure OpenAI:  MODEL=azure_openai:<your-deployment-name>
#                  AZURE_OPENAI_API_KEY=...
#                  AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
#                  OPENAI_API_VERSION=2024-10-21
#
#   OpenAI:        MODEL=openai:gpt-4o
#                  OPENAI_API_KEY=...
#
#   Anthropic:     MODEL=anthropic:claude-sonnet-5
#                  ANTHROPIC_API_KEY=...
#
# The key line lives here only until Chapter 4 moves it into the Keycard
# vault; MODEL itself stays either way.
MODEL=

# ── Keycard (Chapter 3) ──────────────────────────────────────────────────────
# Your Issuer URL (Organization Settings → OAuth in the Keycard console).
KEYCARD_ZONE_URL=

# Your application's credentials, created in Chapter 3. The client secret is
# shown once when you create it, and this file is the only place it lives.
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=

# Your agent's own resource, the one your application provides, registered
# in Chapter 3. Sign-in tokens are audienced to it; type it exactly as
# registered, for example urn:keycard-workshop:agent:resource:yourname.
AGENT_RESOURCE=

# ── The LLM key's vault resource (Chapter 4) ─────────────────────────────────
# Your LLM key's own vault resource, registered in Chapter 4 when the key
# moves out of this file. Type it exactly as registered, for example
# urn:keycard-workshop:llm:key:yourname.
LLM_KEY_RESOURCE=

# ── Provisioned ──────────────────────────────────────────────────────────────
# The requests MCP server. The URL is also the resource identifier
# registered in Keycard (Chapter 1); a near-miss fails credential requests
# with `invalid_target`, so change it only together with the registration.
REQUESTS_MCP=http://localhost:8300/mcp

# The hosted requests API, which Chapter 7's reviewer calls directly as the
# agent itself, and the resource Keycard mints that token for (also registered
# in Chapter 1; your application depends on it from Chapter 3).
REQUESTS_API_URL=https://keycard-workshop-requests-api.fly.dev
REQUESTS_API_INTEGRATIONS=https://keycard-workshop-requests-api.fly.dev/integrations

# The port the agent's web app serves on. The browser signs in and is
# redirected back to this same app, so the port must match your application's
# registered redirect URI: http://localhost:8484/callback
AGENT_PORT=8484

# The email domain the agent assumes when working out a person's address
# from their name (firstname.lastname@<domain>). Set it to your org's
# domain; example.com if unset.
EMAIL_DOMAIN=mlp.com
