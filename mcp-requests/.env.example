# Copy this file to .env (same folder). Instructors pre-fill the values below
# except where a chapter tells you otherwise.

# ── The shared dashboard (Chapter 0) ─────────────────────────────────────────
# The hosted request dashboard the whole cohort shares, and the workshop's shared
# API key. The key is the antipattern Chapter 2 tears out: you'll delete the
# REQUESTS_API_KEY line from your .env there, along with the code that read it.
# Leave REQUESTS_API_URL empty to run an offline local dashboard.
REQUESTS_API_URL=
REQUESTS_API_KEY=

# ── Keycard (Chapter 2) ──────────────────────────────────────────────────────
# The workshop zone's Issuer URL, pre-filled by instructors.
KEYCARD_ZONE_URL=

# This MCP server's application credentials in Keycard, pre-provisioned by
# instructors. The server uses them to continue the caller's delegation
# chain: it exchanges the token it received for one minted for the requests API.
# Only this application may do that exchange: it is registered as the one
# that provides this server's resource.
REQUESTS_MCP_CLIENT_ID=
REQUESTS_MCP_CLIENT_SECRET=

# The requests API's identifier exactly as registered in Keycard; a near-miss
# fails token exchange with `invalid_target`. It is a name, not the API's
# address (urn:keycard-workshop:requests:api in this workshop), so it stays
# put wherever the API is hosted.
REQUESTS_API_RESOURCE=urn:keycard-workshop:requests:api
